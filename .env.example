# Copy to .env and fill in.
#
# Local development (SQLite, zero external infrastructure):
DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL) — also change `provider` in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexora?schema=public"

# Strong random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NEXORA_SESSION_SECRET="replace-with-a-long-random-secret"

NEXORA_APP_NAME="NEXORA OS"
NEXORA_DEFAULT_LOCALE="en"

# Optional (future): Redis for queues/cache, S3-compatible object storage for files.
# REDIS_URL="redis://localhost:6379"
# S3_ENDPOINT=""
# S3_BUCKET=""
