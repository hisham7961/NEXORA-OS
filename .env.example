# Copy to .env and fill in. PostgreSQL is the database for local dev AND production.
#
# Local dev (docker compose up -d db — see docker-compose.yml):
DATABASE_URL="postgresql://nexora:nexora@localhost:5432/nexora?schema=public"
#
# Production: a managed PostgreSQL connection string (injected via your secrets store).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexora?schema=public&sslmode=require"

# Strong random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production startup REFUSES a missing / placeholder / short (<32 char) secret.
NEXORA_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

NEXORA_APP_NAME="NEXORA OS"
NEXORA_DEFAULT_LOCALE="en"

# Optional (future): Redis for queues/cache, S3-compatible object storage for files.
# REDIS_URL="redis://localhost:6379"
# S3_ENDPOINT=""
# S3_BUCKET=""
