FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV NODE_OPTIONS="--max-old-space-size=1536"
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim AS production
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy only the runtime artifacts, not the whole build tree (audit PLAT-11): this
# drops src/, tests/, docs/ and scripts/ from the shipped image. node_modules is
# kept whole because `prisma` (a devDependency) runs `migrate deploy` at container
# start — the Prisma CLI and the production deps both live there.
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/next.config.ts ./
COPY --from=build /app/prisma ./prisma

# Run unprivileged (audit PLAT-10): the base image ships a `node` user (uid 1000).
RUN chown -R node:node /app
USER node

EXPOSE 3000

# exec-form invoking Next directly so the Node process (not an npm wrapper) is what
# receives SIGTERM; with the compose `init: true` this yields graceful shutdown on
# rollout instead of an in-flight SIGKILL (audit PLAT-09). The compose service
# overrides this to first apply migrations, but keeps the same exec pattern.
CMD ["node_modules/.bin/next", "start", "-p", "3000"]
