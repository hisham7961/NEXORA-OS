// ============================================================================
// NEXORA OS — Domain data model
// ----------------------------------------------------------------------------
// The central operating system for a multi-company, multi-brand cosmetics group.
//
// DATABASE (PostgreSQL — local dev + production, Phase 2 Part C)
//   Both local dev and production run PostgreSQL (docker-compose.yml for local).
//   Deployment applies versioned migrations in prisma/migrations (never db push).
//   The schema deliberately stays clean and portable:
//     * statuses/types are Strings backed by configurable StatusDefinition /
//       WorkflowTemplate rows (§7 "statuses must be configurable", §50 workflow
//       engine) rather than hard-coded DB enums.
//     * money is Decimal; JSON blobs are stored as String (`*Json`) so the schema
//       is identical on both engines.
//
// RELATIONSHIP CONVENTION (§54)
//   Everything is relational, but with dozens of modules a formal Prisma relation
//   for every cross-domain reference would explode into thousands of back-relation
//   fields. So the convention is:
//     * Cross-domain references are INDEXED SCALAR foreign keys (e.g. `brandId`),
//       queried directly (`where: { brandId }`) and name-resolved in the service
//       layer. This is the scalable "reference by stable id" pattern.
//     * Formal Prisma relations are declared only WITHIN tight aggregate clusters
//       where nested reads/writes are genuinely convenient (a Task and its
//       assignees, a JournalEntry and its lines, a Role and its permissions, ...).
//   Actor/bookkeeping references (createdById, ownerId, assignedToId, ...) are
//   always scalar user ids.
//
// AUDIT & SOFT-DELETE (§31, §32, §54)
//   Operationally important records carry createdAt/updatedAt and, where history
//   must never be silently destroyed, `archivedAt` for soft-delete. Sensitive
//   mutations are recorded in AuditLog by the service layer.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL is the production AND local database (Phase 2, Part C). The schema
  // avoids DB enums / scalar lists / Json columns so it stays clean and portable,
  // but Postgres is now the single source of truth — migrations live in
  // prisma/migrations and are the deployment path (never `prisma db push` in prod).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY & ACCESS  (§3 permissions is the critical requirement)
// ============================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  isSuperAdmin Boolean   @default(false) // §3 "Super Admin can see everything"
  status       String    @default("active") // active | suspended | invited
  locale       String    @default("en") // en | ar (§39)
  timezone     String    @default("Asia/Kuwait") // §40 per-employee timezone
  avatarColor  String?
  title        String?
  phone        String?
  lastLoginAt  DateTime?
  // MFA / TOTP (§26-27). Secret is sealed (AES-GCM) at rest; recovery codes are
  // stored only as hashes. mfaEnabledAt null = not yet confirmed (or disabled).
  mfaSecret       String?
  mfaEnabledAt    DateTime?
  mfaRecoveryJson String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  employee        Employee?
  sessions        Session[]
  roleAssignments RoleAssignment[]
  teamMemberships TeamMember[]
  notifications   Notification[]

  @@index([status])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// A Role is a configurable named bundle of permission keys (from the code catalog).
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  assignments RoleAssignment[]
}

model RolePermission {
  id            String @id @default(cuid())
  roleId        String
  permissionKey String // e.g. "campaigns.edit" — validated against the code catalog

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
}

// Binds a User to a Role WITHIN a scope. A null dimension means "all" of it.
// e.g. { role: marketing_manager, brandId: A, countryId: KW } = Marketing Manager
// for Brand A in Kuwait only (§3). This is the heart of scope-based access control.
model RoleAssignment {
  id           String    @id @default(cuid())
  userId       String
  roleId       String
  companyId    String?
  brandId      String?
  countryId    String?
  departmentId String?
  teamId       String?
  moduleKey    String? // optionally restrict to a single module area
  grantedById  String?
  note         String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([brandId])
  @@index([countryId])
  @@index([companyId])
}

// ============================================================================
// ORGANIZATION  (§2 hierarchy, §23 employees/teams)
// ============================================================================

model Company {
  id                   String    @id @default(cuid())
  name                 String
  legalName            String?
  code                 String    @unique
  baseCurrency         String    @default("KWD")
  hqCountryId          String?
  timezone             String    @default("Asia/Kuwait")
  fiscalYearStartMonth Int       @default(1)
  logoColor            String?
  status               String    @default("active")
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  archivedAt           DateTime?

  brandLinks BrandCompany[]

  @@index([status])
}

model Brand {
  id               String    @id @default(cuid())
  name             String
  code             String    @unique
  slug             String    @unique
  description      String?
  status           String    @default("active")
  primaryCompanyId String?
  accentColor      String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  companyLinks BrandCompany[]
  markets      BrandMarket[]

  @@index([status])
}

// A brand may be associated with more than one legal company (§2).
model BrandCompany {
  id        String  @id @default(cuid())
  brandId   String
  companyId String
  isPrimary Boolean @default(false)

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([brandId, companyId])
  @@index([companyId])
}

// Global country/market master data.
model Country {
  id        String   @id @default(cuid())
  name      String
  iso2      String   @unique
  iso3      String?
  currency  String
  timezone  String   @default("Asia/Kuwait")
  region    String?
  phoneCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandMarkets BrandMarket[]
}

model BrandMarket {
  id         String    @id @default(cuid())
  brandId    String
  countryId  String
  status     String    @default("active")
  launchedAt DateTime?

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([brandId, countryId])
  @@index([countryId])
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String?
  companyId   String?
  parentId    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([companyId])
}

model Team {
  id           String    @id @default(cuid())
  name         String
  departmentId String?
  brandId      String?
  leadUserId   String?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  members TeamMember[]

  @@index([departmentId])
  @@index([brandId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("member") // lead | member

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Employee {
  id               String    @id @default(cuid())
  userId           String    @unique
  companyId        String?
  departmentId     String?
  teamId           String?
  managerId        String? // -> Employee.id
  position         String?
  joinDate         DateTime?
  workScheduleId   String?
  employmentStatus String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandAssignments   EmployeeBrand[]
  countryAssignments EmployeeCountry[]

  @@index([companyId])
  @@index([departmentId])
  @@index([managerId])
}

model EmployeeBrand {
  id         String @id @default(cuid())
  employeeId String
  brandId    String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, brandId])
  @@index([brandId])
}

model EmployeeCountry {
  id         String @id @default(cuid())
  employeeId String
  countryId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, countryId])
  @@index([countryId])
}

// ============================================================================
// PRODUCTS  (§13 product master)
// ============================================================================

model Product {
  id          String    @id @default(cuid())
  brandId     String
  name        String
  sku         String    @unique
  barcode     String?
  category    String?
  description String?
  status      String    @default("active")
  launchDate  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  variants ProductVariant[]
  markets  ProductMarket[]
  claims   ProductClaim[]

  @@index([brandId, status])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String
  sku       String?
  size      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMarket {
  id        String @id @default(cuid())
  productId String
  countryId String
  status    String @default("planned")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, countryId])
  @@index([countryId])
}

model ProductClaim {
  id           String   @id @default(cuid())
  productId    String
  countryId    String?
  claim        String
  isApproved   Boolean  @default(false)
  approvedById String?
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================================
// REGULATORY  (§14 global registration engine)
// ============================================================================

model RegulatoryAuthority {
  id        String   @id @default(cuid())
  name      String
  countryId String
  code      String?
  website   String?
  createdAt DateTime @default(now())

  @@index([countryId])
}

model RegistrationType {
  id                 String   @id @default(cuid())
  name               String
  authorityId        String?
  countryId          String?
  description        String?
  workflowTemplateId String?
  createdAt          DateTime @default(now())
}

model RegistrationCase {
  id                 String    @id @default(cuid())
  productId          String?
  brandId            String?
  companyId          String?
  countryId          String
  authorityId        String?
  registrationTypeId String?
  registrationNumber String?
  status             String    @default("preparation") // workflow stage key
  assignedToId       String?
  agentName          String?
  submissionDate     DateTime?
  approvalDate       DateTime?
  expiryDate         DateTime?
  renewalDate        DateTime?
  expectedCompletion DateTime?
  notes              String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  events  RegistrationEvent[]
  docReqs RegistrationDocReq[]

  @@index([countryId, status])
  @@index([brandId])
  @@index([productId])
  @@index([assignedToId])
  @@index([expiryDate])
}

model RegistrationEvent {
  id          String   @id @default(cuid())
  caseId      String
  type        String
  title       String
  description String?
  actorId     String?
  createdAt   DateTime @default(now())

  case RegistrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model RegistrationDocReq {
  id             String   @id @default(cuid())
  caseId         String
  documentTypeId String?
  name           String
  status         String   @default("required") // required | received | submitted | missing
  fileId         String?
  createdAt      DateTime @default(now())

  case RegistrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============================================================================
// DOCUMENTS & CERTIFICATES  (§15 expiration system)
// ============================================================================

model DocumentType {
  id                  String   @id @default(cuid())
  name                String
  code                String?
  category            String?
  defaultValidityDays Int?
  createdAt           DateTime @default(now())
}

model Document {
  id                String    @id @default(cuid())
  documentTypeId    String?
  companyId         String?
  brandId           String?
  productId         String?
  countryId         String?
  number            String?
  title             String
  issueDate         DateTime?
  expiryDate        DateTime?
  version           Int       @default(1)
  status            String    @default("valid") // valid | expiring | expired | renewal_started | replaced | archived
  visibility        String    @default("internal") // internal | restricted
  ownerId           String?
  fileId            String?
  createdById       String?
  // JSON int[] of expiry day-thresholds already reminded for the current
  // expiryDate (reset when expiryDate changes) — keeps the reminder job idempotent.
  remindersSentJson String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  @@index([expiryDate])
  @@index([brandId])
  @@index([status])
}

// ============================================================================
// FILES  (§21 file management, §52 versioning)
// ============================================================================

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  scopeType String   @default("shared") // shared|department|brand|product|regulatory|creative|restricted|vault
  companyId String?
  brandId   String?
  createdAt DateTime @default(now())

  @@index([parentId])
}

model File {
  id               String    @id @default(cuid())
  name             String
  mimeType         String? // mime of the current version (denormalized for lists)
  sizeBytes        Int? // size of the current version
  storageKey       String // storage key of the current version (denormalized)
  checksum         String?
  category         String    @default("document") // document|image|video|creative|regulatory|contract|spreadsheet|other
  tagsJson         String? // JSON string[] (portability: no scalar lists)
  description      String?
  folderId         String?
  ownerId          String?
  // Scope for server-side permission (mirrors other domain models).
  companyId        String?
  brandId          String?
  countryId        String?
  visibility       String    @default("internal") // internal | restricted
  relatedType      String? // primary entity this file was created against
  relatedId        String?
  currentVersionId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  versions    FileVersion[]
  attachments FileAttachment[]

  @@index([folderId])
  @@index([relatedType, relatedId])
  @@index([brandId])
  @@index([category])
}

model FileVersion {
  id           String   @id @default(cuid())
  fileId       String
  version      Int
  storageKey   String
  sizeBytes    Int?
  mimeType     String?
  checksum     String?
  uploadedById String?
  note         String?
  createdAt    DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
}

// Links one file to any number of NEXORA entities (§5) — one file platform,
// many attachment points. The file's own scope still governs access.
model FileAttachment {
  id          String   @id @default(cuid())
  fileId      String
  entityType  String
  entityId    String
  createdById String?
  createdAt   DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, entityType, entityId])
  @@index([entityType, entityId])
}

// ============================================================================
// WORK MANAGEMENT  (§7 universal task engine, projects)
// ============================================================================

model Project {
  id          String    @id @default(cuid())
  name        String
  brandId     String?
  companyId   String?
  ownerId     String?
  status      String    @default("active")
  startDate   DateTime?
  dueDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([brandId])
}

model Task {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  ownerId            String?
  priority           String    @default("normal") // low | normal | high | urgent
  status             String    @default("todo") // configurable via StatusDefinition(module="task")
  startDate          DateTime?
  dueDate            DateTime?
  completedAt        DateTime?
  projectId          String?
  parentTaskId       String?
  recurrenceRule     String?
  approvalRequired   Boolean   @default(false)
  tagsJson           String?
  // queryable relational links (§7 "tasks can relate to ..."):
  companyId          String?
  brandId            String?
  countryId          String?
  productId          String?
  campaignId         String?
  storeId            String?
  registrationCaseId String?
  customerCaseId     String?
  designRequestId    String?
  documentId         String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  assignees TaskAssignee[]
  checklist TaskChecklistItem[]

  @@index([status, dueDate])
  @@index([ownerId])
  @@index([brandId])
  @@index([companyId])
  @@index([dueDate])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String
  role   String @default("assignee") // assignee | watcher

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, role])
  @@index([userId])
}

model TaskChecklistItem {
  id       String    @id @default(cuid())
  taskId   String
  text     String
  isDone   Boolean   @default(false)
  doneById String?
  doneAt   DateTime?
  order    Int       @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  @@unique([taskId, dependsOnTaskId])
}

// ============================================================================
// DAILY CHECK SYSTEM  (§8 recurring daily responsibilities)
// ============================================================================

model ChecklistTemplate {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  brandId            String?
  departmentId       String?
  scheduleType       String    @default("daily") // daily | weekdays | weekly | monthly | custom
  scheduleConfigJson String?
  isActive           Boolean   @default(true)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  items       ChecklistTemplateItem[]
  assignments ChecklistAssignment[]
  instances   ChecklistInstance[]

  @@index([brandId])
}

model ChecklistTemplateItem {
  id                 String  @id @default(cuid())
  templateId         String
  text               String
  requiresNote       Boolean @default(false)
  requiresLink       Boolean @default(false)
  requiresAttachment Boolean @default(false)
  requiresApproval   Boolean @default(false)
  order              Int     @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ChecklistAssignment {
  id         String    @id @default(cuid())
  templateId String
  userId     String
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId])
}

model ChecklistInstance {
  id           String    @id @default(cuid())
  templateId   String
  userId       String
  date         DateTime // the day this instance is for
  status       String    @default("pending") // pending | complete | late | missed
  score        Int?
  completedAt  DateTime?
  verifiedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  template ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ChecklistInstanceItem[]

  @@unique([templateId, userId, date])
  @@index([userId, date])
  @@index([status])
}

model ChecklistInstanceItem {
  id             String    @id @default(cuid())
  instanceId     String
  templateItemId String?
  text           String
  isDone         Boolean   @default(false)
  note           String?
  link           String?
  fileId         String?
  doneAt         DateTime?
  isLate         Boolean   @default(false)

  instance ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
}

// ============================================================================
// ATTENDANCE  (§22 accountability, not surveillance)
// ============================================================================

model WorkSchedule {
  id         String   @id @default(cuid())
  name       String
  companyId  String?
  timezone   String   @default("Asia/Kuwait")
  configJson String? // days + start/end times
  createdAt  DateTime @default(now())
}

model AttendanceRecord {
  id                 String    @id @default(cuid())
  userId             String
  date               DateTime
  expectedStart      DateTime?
  expectedEnd        DateTime?
  actualStart        DateTime?
  actualEnd          DateTime?
  lateMinutes        Int       @default(0)
  earlyLeaveMinutes  Int       @default(0)
  overtimeMinutes    Int       @default(0)
  breakMinutes       Int       @default(0)
  totalWorkedMinutes Int       @default(0)
  status             String    @default("present") // present | absent | leave | holiday | late
  notes              String?
  adjustedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  events AttendanceEvent[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([status])
}

model AttendanceEvent {
  id        String   @id @default(cuid())
  recordId  String?
  userId    String
  type      String // check_in | break_start | break_end | check_out
  at        DateTime
  source    String?
  ip        String?
  createdAt DateTime @default(now())

  record AttendanceRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  userId     String
  type       String // annual | sick | unpaid | public_holiday
  startDate  DateTime
  endDate    DateTime
  status     String   @default("pending") // pending | approved | rejected
  reason     String?
  approverId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String?
  countryId String?
  name      String
  date      DateTime
  createdAt DateTime @default(now())
}

// ============================================================================
// MARKETING / CAMPAIGNS  (§9)
// ============================================================================

model Campaign {
  id             String    @id @default(cuid())
  name           String
  companyId      String?
  brandId        String?
  countryId      String?
  storeId        String?
  type           String    @default("meta") // meta|instagram|facebook|tiktok|snapchat|google|influencer|whatsapp|email|offline|retail|custom
  objective      String?
  ownerId        String?
  teamId         String?
  startDate      DateTime?
  endDate        DateTime?
  currency       String    @default("KWD")
  plannedBudget  Decimal?
  actualSpend    Decimal?
  status         String    @default("draft") // configurable lifecycle
  targetAudience String?
  channelsJson   String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  products CampaignProduct[]
  metrics  CampaignMetric[]
  reports  CampaignReport[]

  @@index([brandId, status])
  @@index([countryId])
  @@index([ownerId])
}

model CampaignProduct {
  id         String @id @default(cuid())
  campaignId String
  productId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
}

model CampaignMetric {
  id         String    @id @default(cuid())
  campaignId String
  date       DateTime?
  name       String // spend|impressions|reach|clicks|ctr|cpc|cpm|leads|conversions|orders|revenue|roas|custom
  value      Decimal
  unit       String?
