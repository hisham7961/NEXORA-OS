}

model CreativeAsset {
  id              String    @id @default(cuid())
  brandId         String?
  productId       String?
  countryId       String?
  campaignId      String?
  platform        String?
  assetType       String?
  designRequestId String?
  fileId          String?
  designerId      String?
  approvedAt      DateTime?
  tagsJson        String?
  createdAt       DateTime  @default(now())
  archivedAt      DateTime?

  @@index([brandId])
}

// ============================================================================
// COMMERCE / STORES  (§16 — manual performance entry v1)
// ============================================================================

model Store {
  id         String    @id @default(cuid())
  companyId  String?
  brandId    String?
  countryId  String?
  platform   String // shopify|woocommerce|zid|salla|amazon|custom|other
  name       String
  currency   String    @default("KWD")
  url        String?
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  responsibles StoreResponsible[]
  performance  StorePerformance[]

  @@index([brandId])
  @@index([countryId])
}

model StoreResponsible {
  id      String @id @default(cuid())
  storeId String
  userId  String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

model StorePerformance {
  id              String    @id @default(cuid())
  storeId         String
  periodType      String    @default("daily") // daily | weekly | monthly
  periodStart     DateTime
  periodEnd       DateTime?
  // --- INPUT components (entered) — see docs/METRIC_DICTIONARY.md ---
  sales           Decimal? // Gross Sales (before discounts/refunds)
  orders          Int?
  unitsSold       Int?
  returns         Int?
  refunds         Decimal?
  discounts       Decimal?
  cogs            Decimal?
  adSpend         Decimal?
  shippingCost    Decimal?
  conversionRate  Decimal?
  // --- DERIVED, computed server-side from the inputs above ---
  netSales        Decimal? // = sales - discounts - refunds
  aov             Decimal? // = netSales / orders
  grossMargin     Decimal? // Gross Profit = netSales - cogs
  netContribution Decimal? // = grossMargin - adSpend - shippingCost
  campaignId      String?
  notes           String?
  createdAt       DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, periodStart])
}

// ============================================================================
// CUSTOMER SERVICE  (§17 internal cases)
// ============================================================================

model CustomerCase {
  id           String    @id @default(cuid())
  companyId    String?
  brandId      String?
  countryId    String?
  storeId      String?
  productId    String?
  orderRef     String?
  customerRef  String?
  type         String // product_question|complaint|return|refund|damaged|delivery|wrong_item|ecommerce|ad_issue|medical_info|other
  priority     String    @default("normal")
  assignedToId String?
  status       String    @default("new") // new|assigned|waiting|in_progress|escalated|resolved|closed
  description  String?
  resolution   String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  notes CustomerCaseNote[]

  @@index([brandId, status])
  @@index([assignedToId])
}

model CustomerCaseNote {
  id         String   @id @default(cuid())
  caseId     String
  authorId   String?
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  case CustomerCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============================================================================
// APPROVED ANSWER LIBRARY  (§18)
// ============================================================================

// The ANSWER IDENTITY. `answer` is the denormalized current-approved text (fast
// display); the authoritative history lives in AnswerVersion. Only one version
// is the current approved one per identity (§15).
model ApprovedAnswer {
  id               String    @id @default(cuid())
  question         String
  answer           String    @default("")
  brandId          String?
  productId        String?
  countryId        String?
  category         String?
  language         String    @default("en")
  version          Int       @default(1) // current approved version number
  status           String    @default("draft") // draft|pending|approved|retired
  currentVersionId String?
  authorId         String?
  approvedById     String?
  effectiveDate    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  versions AnswerVersion[]

  @@index([brandId])
  @@index([status])
}

// Immutable historical content for each version of an answer (§15).
model AnswerVersion {
  id           String    @id @default(cuid())
  answerId     String
  version      Int
  answer       String
  status       String    @default("draft") // draft|pending|approved|retired
  authorId     String?
  approvedById String?
  changeNote   String?
  effectiveAt  DateTime?
  createdAt    DateTime  @default(now())

  answer_ ApprovedAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([answerId, version])
  @@index([answerId])
}

// Lightweight usage/traceability when an approved answer is copied (§16).
model AnswerUsage {
  id        String   @id @default(cuid())
  answerId  String
  versionId String?
  userId    String?
  caseId    String?
  createdAt DateTime @default(now())

  @@index([answerId])
  @@index([caseId])
}

model AnswerRequest {
  id             String   @id @default(cuid())
  question       String
  requesterId    String?
  brandId        String?
  productId      String?
  countryId      String?
  context        String?
  status         String   @default("pending") // pending|approved|rejected
  resultAnswerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// KNOWLEDGE BASE  (§19)
// ============================================================================

model KnowledgeArticle {
  id               String    @id @default(cuid())
  title            String
  body             String // denormalized current published body
  category         String?
  tagsJson         String?
  authorId         String?
  reviewerId       String?
  brandId          String?
  productId        String?
  countryId        String?
  status           String    @default("draft") // draft|in_review|published|archived
  version          Int       @default(1) // current published version number
  currentVersionId String?
  lastReviewedAt   DateTime?
  reviewDueAt      DateTime?
  visibility       String    @default("internal")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  versions KnowledgeVersion[]

  @@index([brandId])
  @@index([category])
}

// Immutable published/draft content history for an article (§19).
model KnowledgeVersion {
  id           String    @id @default(cuid())
  articleId    String
  version      Int
  title        String
  body         String
  status       String    @default("draft") // draft|in_review|published|superseded
  authorId     String?
  approvedById String?
  changeNote   String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId])
}

// ============================================================================
// COMMUNICATION / DISCUSSIONS  (§20)
// ============================================================================

model Channel {
  id            String    @id @default(cuid())
  name          String
  description   String?
  type          String    @default("general") // brand|company|department|campaign|product|project|registration|store|general
  companyId     String?
  brandId       String?
  countryId     String?
  departmentId  String?
  // Optional link to a specific entity (campaign/product/project/store/registration/…)
  entityType    String?
  entityId      String?
  isPrivate     Boolean   @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  members  ChannelMember[]
  messages Message[]

  @@index([brandId])
  @@index([type])
  @@index([entityType, entityId])
}

model ChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  role       String    @default("member")
  lastReadAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id         String    @id @default(cuid())
  channelId  String
  authorId   String
  body       String
  parentId   String?
  kind       String    @default("message") // message|decision|announcement|action_required
  isPinned   Boolean   @default(false)
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  channel  Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mentions MessageMention[]

  @@index([channelId, createdAt])
}

model MessageMention {
  id        String @id @default(cuid())
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ============================================================================
// COMMENTS & MENTIONS (reusable) + REACTIONS  (§63)
// ============================================================================

model Comment {
  id         String    @id @default(cuid())
  authorId   String
  body       String
  entityType String
  entityId   String
  parentId   String?
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([entityType, entityId])
  @@index([authorId])
}

model Reaction {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId, userId, emoji])
}

// ============================================================================
// APPROVALS  (§24 universal engine)
// ============================================================================

model ApprovalRequest {
  id          String    @id @default(cuid())
  title       String
  entityType  String?
  entityId    String?
  requesterId String?
  type        String // campaign|budget|creative|social|answer|refund|document|expense|purchase|accounting|file|report
  status      String    @default("pending") // pending|approved|rejected|changes
  currentStep Int       @default(1)
  companyId   String?
  brandId     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  steps ApprovalStep[]

  @@index([status])
  @@index([requesterId])
}

model ApprovalStep {
  id             String    @id @default(cuid())
  requestId      String
  order          Int
  approverUserId String?
  approverRole   String?
  status         String    @default("pending") // pending|approved|rejected|changes
  decidedAt      DateTime?
  comment        String?

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, order])
  @@index([approverUserId])
}

// ============================================================================
// SUBSCRIPTIONS  (§25)
// ============================================================================

model Subscription {
  id                String    @id @default(cuid())
  provider          String
  companyId         String?
  brandId           String?
  countryId         String?
  ownerId           String?
  plan              String?
  currency          String    @default("USD")
  cost              Decimal?
  billingCycle      String    @default("monthly") // monthly | yearly | custom
  renewalDate       DateTime?
  autoRenew         Boolean   @default(true)
  paymentMethodRef  String?
  licenses          Int?
  notes             String?
  status            String    @default("active")
  // JSON int[] of day-thresholds already reminded for the CURRENT renewalDate
  // (reset when the renewalDate changes) — keeps the reminder job idempotent.
  remindersSentJson String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  @@index([renewalDate])
  @@index([status])
}

// Employee-initiated attendance correction request + manager decision (§25).
// The original AttendanceRecord is never destroyed; approving applies the change
// and the request row preserves the before/after history.
model AttendanceCorrection {
  id             String    @id @default(cuid())
  userId         String // whose attendance
  recordId       String?
  date           DateTime
  type           String // missed_check_in|missed_check_out|incorrect_time|break_error|other
  reason         String
  field          String? // which field the requestedValue targets (actualStart|actualEnd|breakMinutes|…)
  oldValue       String?
  requestedValue String?
  status         String    @default("pending") // pending|approved|rejected|changes_requested
  reviewerId     String?
  reviewNote     String?
  requestedById  String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@index([status])
}

// ============================================================================
// FINANCE / ACCOUNTING  (§26 — multi-company, multi-currency, dimensional)
// ============================================================================

model FiscalYear {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("open") // open | closed | locked
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  periods AccountingPeriod[]

  @@index([companyId])
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  companyId    String?
  fiscalYearId String
  name         String
  periodType   String    @default("month") // month | adjustment
  startDate    DateTime
  endDate      DateTime
  status       String    @default("open") // open | soft_closed | closed | locked
  closedById   String?
  closedAt     DateTime?
  reopenedById String?
  reopenNote   String?

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([fiscalYearId])
  @@index([companyId, status])
}

model Account {
  id            String    @id @default(cuid())
  companyId     String
  code          String
  name          String
  nameLocalized String?
  type          String // asset | liability | equity | revenue | cogs | expense | other_income | other_expense
  subtype       String? // cash|bank|ar|inventory|prepayment|fixed_asset|ap|accrued|tax_payable|loan|capital|retained_earnings|sales|sales_returns|discount|cogs|marketing|shipping|payroll|professional_fees|rent|utilities|fx
  parentId      String?
  level         Int       @default(0)
  normalBalance String    @default("debit") // debit | credit
  currency      String? // optional single-currency restriction
  allowPosting  Boolean   @default(true) // false = header/summary account
  isSystem      Boolean   @default(false) // referenced by accounting settings; protected
  isActive      Boolean   @default(true)
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  lines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([parentId])
}

model CostCenter {
  id           String    @id @default(cuid())
  companyId    String?
  name         String
  code         String?
  parentId     String?
  departmentId String?
  ownerId      String?
  status       String    @default("active") // active | inactive
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  @@index([companyId])
  @@index([parentId])
}

model JournalEntry {
  id                String    @id @default(cuid())
  companyId         String
  journalId         String?
  journalNumber     String?
  periodId          String?
  date              DateTime // transaction date
  postingDate       DateTime? // GL recognition date (defaults to transaction date)
  documentDate      DateTime?
  reference         String?
  memo              String?
  status            String    @default("draft") // draft | posted | reversed | void
  currency          String    @default("KWD") // entry transaction currency
  baseCurrency      String    @default("KWD")
  exchangeRate      Decimal?
  totalDebitBase    Decimal   @default(0) // denormalised for fast trial balance
  totalCreditBase   Decimal   @default(0)
  // Source traceability (§80) + reversal reciprocity (§14).
  sourceType        String? // SalesInvoice|SupplierBill|Expense|CustomerPayment|SupplierPayment|BankTransfer|CreditNote|OpeningBalance|ManualJournal
  sourceId          String?
  reversalOfEntryId String?
  reversedByEntryId String?
  createdById       String?
  postedById        String?
  postedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  lines JournalLine[]

  @@unique([companyId, journalNumber])
  @@index([companyId, postingDate])
  @@index([companyId, date])
  @@index([status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id                  String    @id @default(cuid())
  entryId             String
  accountId           String
  lineNo              Int       @default(0)
  description         String?
  // Amounts are stored in BASE (company) currency — debit/credit balance and drive
  // the trial balance directly. Transaction-currency detail is kept alongside.
  debit               Decimal   @default(0)
  credit              Decimal   @default(0)
  transactionCurrency String?
  transactionAmount   Decimal? // absolute amount in transaction currency
  exchangeRate        Decimal?
  // analytical dimensions (§17 — Legal Company is on the entry; these are analytical):
  companyId           String?
  brandId             String?
  countryId           String?
  departmentId        String?
  campaignId          String?
  storeId             String?
  productId           String?
  costCenterId        String?
  customerId          String?
  supplierId          String?
  // Bank reconciliation metadata (§E) — flags only, never amounts (posted lines
  // remain immutable). A cleared line is matched to a bank statement.
  reconciliationId    String?
  reconciledAt        DateTime?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([reconciliationId])
  @@index([brandId])
  @@index([countryId])
  @@index([productId])
  @@index([campaignId])
  @@index([storeId])
  @@index([customerId])
  @@index([supplierId])
}

model Customer {
  id                  String    @id @default(cuid())
  companyId           String?
  name                String
  code                String?
  currency            String? // preferred billing currency
  contact             String?
  email               String?
  phone               String?
  addressJson         String? // structured address (JSON text, §4-DB)
  taxId               String? // tax registration number
  paymentTermsDays    Int? // overrides company default terms
  creditLimit         Decimal? // informational credit ceiling (base currency)
  receivableAccountId String? // override AR control account (else settings.receivable)
  brandId             String?
  countryId           String?
  isActive            Boolean   @default(true)
  notes               String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  archivedAt          DateTime?

  invoices    SalesInvoice[]
  creditNotes CreditNote[]
  receipts    CustomerReceipt[]

  @@index([companyId, isActive])
  @@index([brandId])
}

model Supplier {
  id               String    @id @default(cuid())
  companyId        String?
  name             String
  code             String?
  currency         String?
  contact          String?
  email            String?
  phone            String?
  addressJson      String?
  taxId            String?
  paymentTermsDays Int?
  payableAccountId String? // override AP control account (else settings.payable)
  brandId          String?
  countryId        String?
  isActive         Boolean   @default(true)
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  archivedAt       DateTime?

  bills    SupplierBill[]
  credits  SupplierCredit[]
  payments SupplierPayment[]

  @@index([companyId, isActive])
}

// ============================================================================
// ACCOUNTS PAYABLE (Phase 3 — Increment D). Supplier bills, credits and payments.
// Same discipline as AR: documents drive the GL only via the posting engine; rows
// are the AP sub-ledger and carry the posted JournalEntry id (§80).
// ============================================================================

model SupplierBill {
  id             String    @id @default(cuid())
  companyId      String
  supplierId     String
  billNumber     String? // internal number (allocated at post)
  supplierRef    String? // supplier's own invoice number
  status         String    @default("draft") // draft | open | partially_paid | paid | void
  issueDate      DateTime
  dueDate        DateTime?
  currency       String    @default("KWD")
  baseCurrency   String    @default("KWD")
  exchangeRate   Decimal?
  subtotal       Decimal   @default(0)
  taxTotal       Decimal   @default(0)
  total          Decimal   @default(0)
  amountPaid     Decimal   @default(0)
  amountDue      Decimal   @default(0)
  totalBase      Decimal   @default(0)
  brandId        String?
  countryId      String?
  departmentId   String?
  campaignId     String?
  storeId        String?
  reference      String?
  notes          String?
  journalEntryId String?
  createdById    String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  supplier           Supplier                    @relation(fields: [supplierId], references: [id])
  lines              SupplierBillLine[]
  allocations        BillPaymentAllocation[]
  creditApplications SupplierCreditApplication[]

  @@unique([companyId, billNumber])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([dueDate])
}

model SupplierBillLine {
  id               String  @id @default(cuid())
  billId           String
  lineNo           Int     @default(0)
  description      String
  quantity         Decimal @default(1)
  unitPrice        Decimal @default(0)
  discountPct      Decimal @default(0)
  lineNet          Decimal @default(0)
  taxRateId        String?
  taxAmount        Decimal @default(0)
  expenseAccountId String? // Dr account (expense/asset/inventory); else category/settings
  productId        String?
  brandId          String?
  countryId        String?
  departmentId     String?
  campaignId       String?
  storeId          String?
  costCenterId     String?

  bill SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model SupplierCredit {
  id              String    @id @default(cuid())
  companyId       String
  supplierId      String
  creditNumber    String?
  status          String    @default("draft") // draft | open | applied | void
  issueDate       DateTime
  currency        String    @default("KWD")
  baseCurrency    String    @default("KWD")
  exchangeRate    Decimal?
  subtotal        Decimal   @default(0)
  taxTotal        Decimal   @default(0)
  total           Decimal   @default(0)
  amountApplied   Decimal   @default(0)
  amountRemaining Decimal   @default(0)
  totalBase       Decimal   @default(0)
  brandId         String?
  countryId       String?
  reason          String?
  reference       String?
  journalEntryId  String?
  createdById     String?
  postedById      String?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  lines        SupplierCreditLine[]
  applications SupplierCreditApplication[]

  @@unique([companyId, creditNumber])
  @@index([companyId, status])
  @@index([supplierId])
}

model SupplierCreditLine {
  id               String  @id @default(cuid())
  creditId         String
  lineNo           Int     @default(0)
  description      String
  quantity         Decimal @default(1)
  unitPrice        Decimal @default(0)
  lineNet          Decimal @default(0)
  taxRateId        String?
  taxAmount        Decimal @default(0)
  expenseAccountId String?
  productId        String?
  brandId          String?
  countryId        String?
  departmentId     String?
  campaignId       String?
  storeId          String?
  costCenterId     String?

  credit SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
}

model SupplierPayment {
  id              String    @id @default(cuid())
  companyId       String
  supplierId      String
  paymentNumber   String?
  status          String    @default("draft") // draft | posted | void
  paymentDate     DateTime
  currency        String    @default("KWD")
  baseCurrency    String    @default("KWD")
  exchangeRate    Decimal?
  amount          Decimal   @default(0)
  allocatedAmount Decimal   @default(0)
  unappliedAmount Decimal   @default(0)
  amountBase      Decimal   @default(0)
  bankAccountId   String? // funding account override (else settings.cash)
  method          String?
  reference       String?
  notes           String?
  brandId         String?
  countryId       String?
  journalEntryId  String?
  createdById     String?
  postedById      String?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  supplier    Supplier                @relation(fields: [supplierId], references: [id])
  allocations BillPaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId, status])
  @@index([supplierId])
}

/**
 * A supplier payment applied to a specific open bill (sub-ledger; the payment
 * already debited Payable). No over-allocation, enforced transactionally.
 */
model BillPaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  billId    String
  amount    Decimal
  createdAt DateTime @default(now())

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([paymentId, billId])
  @@index([billId])
}

/**
 * A supplier credit applied to an open bill (sub-ledger contra; no new GL).
 */
model SupplierCreditApplication {
  id        String   @id @default(cuid())
  creditId  String
  billId    String
  amount    Decimal
  createdAt DateTime @default(now())

  credit SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  bill   SupplierBill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([creditId, billId])
  @@index([billId])
}

model Invoice {
  id         String    @id @default(cuid())
  companyId  String?
  type       String // receivable | payable
  customerId String?
  supplierId String?
  number     String?
  date       DateTime
  dueDate    DateTime?
  currency   String    @default("KWD")
  amount     Decimal
  amountPaid Decimal   @default(0)
  status     String    @default("open") // draft|open|paid|overdue|void
  brandId    String?
  countryId  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([companyId, status])
  @@index([dueDate])
}

model Payment {
  id            String   @id @default(cuid())
  companyId     String?
  type          String // receipt | payment
  invoiceId     String?
  customerId    String?
  supplierId    String?
  date          DateTime
  amount        Decimal
  currency      String   @default("KWD")
  method        String?
  bankAccountId String?
  reference     String?
  createdAt     DateTime @default(now())

  @@index([companyId])
}

model BankAccount {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  currency    String    @default("KWD")
  number      String?
  type        String    @default("bank") // bank | cash
  glAccountId String? // the GL asset account this bank/cash account maps to (§E)
  bankName    String?
  iban        String?
  isActive    Boolean   @default(true)
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  archivedAt  DateTime?

  transfersFrom   BankTransfer[]       @relation("transferFrom")
  transfersTo     BankTransfer[]       @relation("transferTo")
  reconciliations BankReconciliation[]
  statements      BankStatement[]

  @@index([companyId, isActive])
}

/**
 * A funds movement between two bank/cash accounts of one company (§E). Same
 * currency: Dr destination / Cr source. Cross-currency: convert at rate, any base
 * residual posts to FX gain/loss. One atomic posted journal (BJ).
 */
model BankTransfer {
  id                String    @id @default(cuid())
  companyId         String
  transferNumber    String?
  fromBankAccountId String
  toBankAccountId   String
  date              DateTime
  fromCurrency      String
  toCurrency        String
  fromAmount        Decimal
  toAmount          Decimal
  exchangeRate      Decimal? // from→to
  baseCurrency      String    @default("KWD")
  reference         String?
  notes             String?
  journalEntryId    String?
  createdById       String?
  postedById        String?
  postedAt          DateTime?
  createdAt         DateTime  @default(now())

  fromBankAccount BankAccount @relation("transferFrom", fields: [fromBankAccountId], references: [id])
  toBankAccount   BankAccount @relation("transferTo", fields: [toBankAccountId], references: [id])

  @@unique([companyId, transferNumber])
  @@index([companyId])
}

/**
 * A bank reconciliation session against a statement (§E). GL lines on the bank's
 * account are marked cleared; the cleared balance is compared to the statement.
 */
model BankReconciliation {
  id               String    @id @default(cuid())
  companyId        String
  bankAccountId    String
  statementDate    DateTime
  statementBalance Decimal
  clearedBalance   Decimal   @default(0)
  status           String    @default("open") // open | completed
  note             String?
  createdById      String?
  completedById    String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([companyId, bankAccountId])
}

/**
 * An imported bank statement (§Phase4-4). Statement lines are NEVER posted to the
 * GL directly — they are matched to existing ledger lines during reconciliation.
 */
model BankStatement {
  id             String    @id @default(cuid())
  companyId      String
  bankAccountId  String
  label          String
  fileName       String?
  statementFrom  DateTime?
  statementTo    DateTime?
  openingBalance Decimal?
  closingBalance Decimal?
  lineCount      Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  lines       BankStatementLine[]

  @@index([companyId, bankAccountId])
}

model BankStatementLine {
  id                   String    @id @default(cuid())
  statementId          String
  companyId            String
  bankAccountId        String
  txnDate              DateTime
  valueDate            DateTime?
  description          String
  reference            String?
  amount               Decimal // signed: + = inflow (money into the account), − = outflow
  currency             String?
  runningBalance       Decimal?
  dedupeKey            String // date|amount|reference|description hash for duplicate detection
  matchedJournalLineId String? // the reconciled GL line, once matched
  reconciliationId     String?
  status               String    @default("unmatched") // unmatched | matched
  createdAt            DateTime  @default(now())

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, status])
  @@index([statementId])
  @@index([dedupeKey])
}

model Budget {
  id           String    @id @default(cuid())
  companyId    String?
  name         String
  fiscalYearId String?
  brandId      String?
  countryId    String?
  departmentId String?
  campaignId   String?
  amount       Decimal   @default(0) // denormalised total of lines
  currency     String    @default("KWD")
  periodicity  String    @default("annual") // annual | quarterly | monthly (§Phase4-3)
  status       String    @default("draft") // draft | active | archived
  periodStart  DateTime?
  periodEnd    DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  lines BudgetLine[]

  @@index([brandId])
  @@index([companyId])
}

/**
 * A budgeted amount for one GL account within a budget (annual, or monthly when
 * `periodMonth` is set). Budget-vs-Actual compares these to posted GL activity.
 */
model BudgetLine {
  id          String  @id @default(cuid())
  budgetId    String
  accountId   String
  periodMonth Int? // 1-12 for a monthly budget; null = whole-period amount
  amount      Decimal @default(0)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([accountId])
}

model ExpenseCategory {
  id               String  @id @default(cuid())
  name             String
  code             String?
  parentId         String?
  companyId        String?
  defaultAccountId String? // GL expense account this category maps to (§D)
  taxRateId        String? // default input-tax rate
}

model Expense {
  id               String    @id @default(cuid())
  companyId        String?
  brandId          String?
  countryId        String?
  departmentId     String?
  campaignId       String?
  storeId          String?
  categoryId       String?
  amount           Decimal
  currency         String    @default("KWD")
  date             DateTime
  description      String?
  status           String    @default("pending") // draft|pending|approved|rejected|posted|paid
  submittedById    String?
  approvedById     String?
  fileId           String?
  // GL integration (§D): once approved, an expense posts Dr Expense / Cr Cash|Payable.
  supplierId       String? // when the expense is billed by a supplier (Cr Payable)
  paymentAccountId String? // cash/bank account funding a company-paid expense
  taxAmount        Decimal?  @default(0)
  journalEntryId   String?
  postedById       String?
  postedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  @@index([brandId])
  @@index([companyId, status])
  @@index([date])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  base        String // from currency
  quote       String // to currency (usually a company base currency)
  rate        Decimal
  date        DateTime // effective date
  source      String   @default("manual") // manual | api
  enteredById String?
  createdAt   DateTime @default(now())

  @@unique([base, quote, date])
  @@index([base, quote, date])
}

// ============================================================================
// ACCOUNTING FOUNDATION (Phase 3 — Increment A). Per-company settings, journals
// configuration and concurrency-safe number sequences.
// ============================================================================

/**
 * Per-company accounting configuration (§4). System-account mappings are stored
 * as stable account IDs, never resolved by English name (§6).
 */
model CompanyAccountingSettings {
  id                          String    @id @default(cuid())
  companyId                   String    @unique
  baseCurrency                String    @default("KWD")
  fiscalYearStartMonth        Int       @default(1)
  timezone                    String    @default("Asia/Kuwait")
  roundingPolicy              String    @default("half_up") // half_up | half_even | down | up
  balancingToleranceJson      String? // per-currency minor-unit tolerance overrides
  // System-account mappings (account IDs).
  receivableAccountId         String?
  payableAccountId            String?
  revenueAccountId            String?
  cogsAccountId               String?
  inventoryAccountId          String?
  bankClearingAccountId       String?
  cashAccountId               String?
  inputTaxAccountId           String?
  outputTaxAccountId          String?
  retainedEarningsAccountId   String?
  fxGainAccountId             String?
  fxLossAccountId             String?
  suspenseAccountId           String?
  roundingAccountId           String?
  roundingAdjustmentAccountId String? // base-currency rounding plug for multi-line FX (§Phase4-2)
  // Numbering + terms.
  journalPrefix               String    @default("GJ")
  invoicePrefix               String    @default("INV")
  billPrefix                  String    @default("BILL")
  paymentPrefix               String    @default("PAY")
  defaultPaymentTerms         Int       @default(30) // days
  lockDate                    DateTime? // hard lock — no posting on/before
  softCloseDate               DateTime? // authorized users only on/before
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
}

/**
 * Journal configuration (§9). A Journal is config; a JournalEntry is the txn.
 */
model Journal {
  id           String    @id @default(cuid())
  companyId    String
  code         String // GJ | SJ | PJ | BJ | CJ | EJ | AJ | OB
  name         String
  type         String    @default("general") // general|sales|purchase|bank|cash|expense|adjustment|opening
  numberPrefix String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  @@unique([companyId, code])
  @@index([companyId])
}

/**
 * Concurrency-safe monotonic number sequences (§13/§75). Allocation uses an
 * atomic UPDATE ... RETURNING inside the posting transaction so simultaneous
 * posts can never receive the same number.
 */
model NumberSequence {
  id        String   @id @default(cuid())
  companyId String
  key       String // e.g. journal:GJ:2026, invoice:2026
  prefix    String
  year      Int
  nextValue Int      @default(1)
  padding   Int      @default(6)
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

model TaxRate {
  id                 String    @id @default(cuid())
  companyId          String?
  countryId          String?
  name               String
  rate               Decimal // percentage, e.g. 5.000
  computation        String    @default("exclusive") // exclusive | inclusive
  inputTaxAccountId  String? // recoverable (on purchases)
  outputTaxAccountId String? // payable (on sales)
  effectiveDate      DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
}

// ============================================================================
// ACCOUNTS RECEIVABLE (Phase 3 — Increment C). Sales invoices, credit notes and
// customer receipts. Every issued/posted document drives the GL exclusively via
// the posting engine (posting.ts); these rows are the AR sub-ledger and carry the
// posted JournalEntry id for traceability (§80). Money is Decimal (§DB-money).
// ============================================================================

model SalesInvoice {
  id             String    @id @default(cuid())
  companyId      String
  customerId     String
  invoiceNumber  String? // allocated at issue (concurrency-safe sequence)
  status         String    @default("draft") // draft | issued | partially_paid | paid | void | written_off
  issueDate      DateTime
  dueDate        DateTime?
  documentDate   DateTime?
  currency       String    @default("KWD") // transaction currency
  baseCurrency   String    @default("KWD")
  exchangeRate   Decimal? // txn→base at issue (historical; never recomputed §40)
  // Amounts in TRANSACTION currency; *Base mirrors in company base currency.
  subtotal       Decimal   @default(0) // net of tax, after line discounts
  taxTotal       Decimal   @default(0)
  total          Decimal   @default(0) // subtotal + tax
  amountPaid     Decimal   @default(0) // allocated from receipts + credit notes
  amountDue      Decimal   @default(0) // total − amountPaid
  totalBase      Decimal   @default(0)
  // Header default analytical dimensions (lines may override).
  brandId        String?
  countryId      String?
  departmentId   String?
  campaignId     String?
  storeId        String?
  reference      String?
  notes          String?
  journalEntryId String? // posted GL entry (sourceType = SalesInvoice)
  createdById    String?
  postedById     String?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  customer           Customer                @relation(fields: [customerId], references: [id])
  lines              SalesInvoiceLine[]
  allocations        ReceiptAllocation[]
  creditApplications CreditNoteApplication[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([customerId])
  @@index([dueDate])
  @@index([issueDate])
}

model SalesInvoiceLine {
  id               String  @id @default(cuid())
  invoiceId        String
  lineNo           Int     @default(0)
  description      String
  quantity         Decimal @default(1)
  unitPrice        Decimal @default(0)
  discountPct      Decimal @default(0) // 0..100
  lineNet          Decimal @default(0) // quantity*unitPrice*(1-discount)
  taxRateId        String?
  taxAmount        Decimal @default(0)
  revenueAccountId String? // override (else settings.revenue)
  productId        String?
  brandId          String?
  countryId        String?
  departmentId     String?
  campaignId       String?
  storeId          String?
  costCenterId     String?

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([productId])
}

model CreditNote {
  id               String    @id @default(cuid())
  companyId        String
  customerId       String
  creditNoteNumber String?
  status           String    @default("draft") // draft | issued | applied | void
  issueDate        DateTime
  currency         String    @default("KWD")
  baseCurrency     String    @default("KWD")
  exchangeRate     Decimal?
  subtotal         Decimal   @default(0)
  taxTotal         Decimal   @default(0)
  total            Decimal   @default(0)
  amountApplied    Decimal   @default(0) // applied to invoices
  amountRemaining  Decimal   @default(0) // unapplied customer credit
  totalBase        Decimal   @default(0)
  brandId          String?
  countryId        String?
  reason           String?
  reference        String?
  journalEntryId   String? // sourceType = CreditNote
  createdById      String?
  postedById       String?
  postedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  customer     Customer                @relation(fields: [customerId], references: [id])
  lines        CreditNoteLine[]
  applications CreditNoteApplication[]

  @@unique([companyId, creditNoteNumber])
  @@index([companyId, status])
  @@index([customerId])
}

model CreditNoteLine {
  id               String  @id @default(cuid())
  creditNoteId     String
  lineNo           Int     @default(0)
  description      String
  quantity         Decimal @default(1)
  unitPrice        Decimal @default(0)
  lineNet          Decimal @default(0)
  taxRateId        String?
  taxAmount        Decimal @default(0)
  revenueAccountId String?
  productId        String?
  brandId          String?
  countryId        String?
  departmentId     String?
  campaignId       String?
  storeId          String?
  costCenterId     String?

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

model CustomerReceipt {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String
  receiptNumber   String?
  status          String    @default("draft") // draft | posted | void
  receiptDate     DateTime
  currency        String    @default("KWD")
  baseCurrency    String    @default("KWD")
  exchangeRate    Decimal?
  amount          Decimal   @default(0) // total received
  allocatedAmount Decimal   @default(0) // sum of allocations
  unappliedAmount Decimal   @default(0) // amount − allocated (customer credit)
  amountBase      Decimal   @default(0)
  bankAccountId   String? // deposit account override (else settings.cash)
  method          String? // bank | cash | card | cheque | transfer
  reference       String?
  notes           String?
  brandId         String?
  countryId       String?
  journalEntryId  String? // sourceType = CustomerReceipt
  createdById     String?
  postedById      String?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  customer    Customer            @relation(fields: [customerId], references: [id])
  allocations ReceiptAllocation[]

  @@unique([companyId, receiptNumber])
  @@index([companyId, status])
  @@index([customerId])
}

/**
 * A receipt applied to a specific open invoice (sub-ledger; no extra GL — the
 * receipt already credited Receivable). Sum of allocations ≤ receipt amount and
 * ≤ invoice amountDue, enforced transactionally (§no-over-allocation).
 */
model ReceiptAllocation {
  id        String   @id @default(cuid())
  receiptId String
  invoiceId String
  amount    Decimal
  createdAt DateTime @default(now())

  receipt CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
}

/**
 * A credit note applied to an open invoice (sub-ledger contra; both documents
 * already posted to Receivable, so application nets them without new GL).
 */
model CreditNoteApplication {
  id           String   @id @default(cuid())
  creditNoteId String
  invoiceId    String
  amount       Decimal
  createdAt    DateTime @default(now())

  creditNote CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoice    SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([creditNoteId, invoiceId])
  @@index([invoiceId])
}

// ============================================================================
// NOTIFICATIONS  (§30)
// ============================================================================

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  state      String    @default("unread") // unread | read | archived
  readAt     DateTime?
  groupKey   String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([createdAt])
  // Write-time dedup + grouping collapse a repeat event onto the existing
  // notification per (user, entity) instead of accumulating duplicate rows.
  @@index([userId, groupKey])
}

model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  channel  String // inapp | email
  category String
  enabled  Boolean @default(true)

  @@unique([userId, category, channel])
}

// ============================================================================
// AUDIT  (§31 — every sensitive action)
// ============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  summary       String?
  oldValuesJson String?
  newValuesJson String?
  ip            String?
  userAgent     String?
  companyId     String?
  brandId       String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ============================================================================
// PLATFORM / ADMIN — no hidden systems (§34, §35, §36, §37, §49, §48, §61, §74)
// ============================================================================

model StatusDefinition {
  id         String  @id @default(cuid())
  module     String // task | campaign | customer_case | registration | design | ...
  key        String
  label      String
  category   String  @default("neutral") // neutral | info | success | warning | critical
  order      Int     @default(0)
  isDefault  Boolean @default(false)
  isTerminal Boolean @default(false)

  @@unique([module, key])
  @@index([module])
}

model WorkflowTemplate {
  id             String   @id @default(cuid())
  name           String
  module         String
  description    String?
  definitionJson String // stages, transitions, required fields/approvals/docs
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([module])
}

// ============================================================================
// CONFIGURABLE WORKFLOW ENGINE (§26–27, §50)
// Versioned declarative workflows. A WorkflowDefinition is the stable identity;
// each WorkflowVersion is an immutable declarative spec (stages / transitions /
// required fields, documents, approvals, roles, SLA, escalation, permissions).
// Live records run as WorkflowInstances BOUND to the exact version they started
// under, so editing a draft or activating a new version never silently changes
// the meaning of records already in flight. A definition is validated before a
// version can be activated.
// ============================================================================

model WorkflowDefinition {
  id               String    @id @default(cuid())
  key              String    @unique // stable machine key, e.g. "registration_approval"
  name             String
  module           String // module the workflow governs (registrations, cases, ...)
  description      String?
  status           String    @default("draft") // draft | active | archived
  // Optional scoping — a workflow may be group-wide (nulls) or scoped.
  companyId        String?
  brandId          String?
  countryId        String?
  currentVersionId String? // the active published version
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  versions  WorkflowVersion[]  @relation("DefinitionVersions")
  instances WorkflowInstance[]

  @@index([module])
  @@index([status])
}

model WorkflowVersion {
  id             String    @id @default(cuid())
  definitionId   String
  version        Int
  status         String    @default("draft") // draft | active | retired
  definitionJson String // declarative spec (stages/transitions/rules) as text (§4)
  changeNote     String?
  activatedAt    DateTime?
  activatedById  String?
  retiredAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  definition WorkflowDefinition @relation("DefinitionVersions", fields: [definitionId], references: [id], onDelete: Cascade)
  instances  WorkflowInstance[]

  @@unique([definitionId, version])
  @@index([definitionId])
  @@index([status])
}

model WorkflowInstance {
  id           String    @id @default(cuid())
  definitionId String
  versionId    String // BOUND version — never changes without an explicit migration
  entityType   String // governed record type, e.g. "RegistrationCase"
  entityId     String
  currentStage String
  status       String    @default("active") // active | completed | cancelled
  // Denormalized scope of the target record (for scoped lists + IDOR guard).
  companyId    String?
  brandId      String?
  countryId    String?
  dataJson     String? // collected required-field values, as JSON text
  dueAt        DateTime? // SLA deadline for the current stage
  escalatedAt  DateTime? // last escalation fired for the current stage (idempotency)
  startedById  String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  definition WorkflowDefinition      @relation(fields: [definitionId], references: [id])
  version    WorkflowVersion         @relation(fields: [versionId], references: [id])
  logs       WorkflowTransitionLog[]

  @@unique([entityType, entityId])
  @@index([definitionId])
  @@index([status, dueAt])
  @@index([currentStage])
}

model WorkflowTransitionLog {
  id            String   @id @default(cuid())
  instanceId    String
  fromStage     String?
  toStage       String
  transitionKey String?
  actorId       String?
  note          String?
  at            DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
}

model SavedView {
  id          String   @id @default(cuid())
  userId      String?
  module      String
  name        String
  filtersJson String
  isShared    Boolean  @default(false)
  teamId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([module])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  label      String? // display label captured at favorite time
  href       String? // deep link to the entity
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
}

/** Import history (§Phase4-18/84). One row per committed import; the source file
 *  name and row counts are retained for audit. */
model ImportBatch {
  id          String   @id @default(cuid())
  resource    String
  companyId   String?
  fileName    String?
  status      String   @default("completed") // completed | failed
  total       Int      @default(0)
  created     Int      @default(0)
  updated     Int      @default(0)
  skipped     Int      @default(0)
  errorCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([resource])
  @@index([createdById])
}

model RecentItem {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  label      String?
  href       String?
  viewedAt   DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, viewedAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  name       String
  userId     String?
  tokenHash  String    @unique
  prefix     String
  scopesJson String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  valueJson   String
  category    String   @default("general")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model FeatureRegistry {
  id                 String  @id @default(cuid())
  key                String  @unique
  name               String
  module             String
  webAvailable       Boolean @default(true)
  mobileApiAvailable Boolean @default(false)
  permissionKey      String?
  endpoint           String?
  status             String  @default("available") // available | planned | beta
  notes              String?
}

model BackgroundJob {
  id             String    @id @default(cuid())
  name           String
  type           String // recurring | scheduled | queue
  status         String    @default("queued") // queued | running | success | failed
  scheduleCron   String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastDurationMs Int?
  lastError      String?
  payloadJson    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  runs BackgroundJobRun[]

  @@index([status])
}

/**
 * Append-only run history for scheduled/manual job executions (§10, observability).
 */
model BackgroundJobRun {
  id         String    @id @default(cuid())
  jobId      String?
  jobName    String
  trigger    String    @default("scheduled") // scheduled | manual
  status     String // success | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  resultJson String?
  error      String?

  job BackgroundJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobName, startedAt])
  @@index([status])
}

/** Fleet-wide run lock (§37-38). The unique (jobName, periodKey) means only one app
 *  instance can claim a given job-minute, so scheduled jobs fire exactly once across
 *  a multi-instance deployment. Rows are purged after a few days. */
model JobRunClaim {
  id        String   @id @default(cuid())
  jobName   String
  periodKey String // minute bucket, e.g. "202609100241"
  claimedAt DateTime @default(now())

  @@unique([jobName, periodKey])
  @@index([claimedAt])
}

model SystemEvent {
  id        String   @id @default(cuid())
  type      String // error | integration | webhook | health
  level     String   @default("info") // info | warning | error
  message   String
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([level])
  @@index([createdAt])
}
