// ============================================================================
// CREATIVE / DESIGN  (§12)
// ============================================================================

model DesignRequest {
  id             String    @id @default(cuid())
  requesterId    String?
  companyId      String?
  brandId        String?
  countryId      String?
  productId      String?
  campaignId     String?
  assetType      String // post|banner|packaging|video|...
  dimensions     String?
  platform       String?
  copy           String?
  referencesJson String?
  deadline       DateTime?
  priority       String    @default("normal")
  designerId     String?
  reviewerId     String?
  status         String    @default("requested") // requested|brief_review|assigned|designing|internal_review|revision|waiting_approval|approved|delivered|published|archived
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  versions DesignVersion[]

  @@index([brandId, status])
  @@index([designerId])
}

model DesignVersion {
  id              String   @id @default(cuid())
  designRequestId String
  version         Int
  fileId          String?
  note            String?
  uploadedById    String?
  isApproved      Boolean  @default(false)
  isRejected      Boolean  @default(false)
  createdAt       DateTime @default(now())

  request DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)

