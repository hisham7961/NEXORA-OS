# --- Local development environment (SQLite so the foundation runs with zero infra) ---
# Production uses PostgreSQL: set DATABASE_URL to a postgres:// URL and change the
# provider in prisma/schema.prisma to "postgresql". The schema is written portably.
DATABASE_URL="file:./dev.db"

# Session signing secret (dev only — production must inject a strong secret via
# a managed secrets store, never commit real secrets).
NEXORA_SESSION_SECRET="dev-only-insecure-secret-change-in-production-0000000000000000"

# App
NEXORA_APP_NAME="NEXORA OS"
NEXORA_DEFAULT_LOCALE="en"
NODE_ENV="development"
