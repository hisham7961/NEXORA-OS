# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
.idea
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets. Local dev copies .env.example → .env.
# Production injects secrets via a managed secrets store.
.env
.env.local
.env.production
.env*.local
!.env.example

# database (local sqlite dev database + prisma engine cache)
/prisma/*.db
/prisma/*.db-journal
/prisma/migrations/dev.db

# testing
/coverage

# typescript
*.tsbuildinfo
